{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hi-ai-models/catalog.schema.json",
  "title": "hi.ai model catalog, schema_version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "about",
    "checked",
    "local_chat",
    "local_code",
    "brain_embed",
    "cloud"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "about": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "checked": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "local_chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "picked_from",
        "memory",
        "models"
      ],
      "properties": {
        "picked_from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "memory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "repo",
              "file",
              "size_gb",
              "licence",
              "about",
              "source",
              "checked",
              "min_ram_gb",
              "ram_gb"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
                "not": {
                  "pattern": "\\.\\."
                }
              },
              "file": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}\\.gguf$",
                "not": {
                  "pattern": "\\.\\."
                }
              },
              "size_gb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "licence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "about": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              },
              "checked": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "min_ram_gb": {
                "type": "number",
                "minimum": 0
              },
              "ram_gb": {
                "type": "number",
                "minimum": 0
              },
              "rank": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "local_code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "picked_from",
        "memory",
        "models"
      ],
      "properties": {
        "picked_from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "memory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "repo",
              "file",
              "size_gb",
              "licence",
              "about",
              "source",
              "checked",
              "min_ram_gb",
              "ram_gb"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
                "not": {
                  "pattern": "\\.\\."
                }
              },
              "file": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}\\.gguf$",
                "not": {
                  "pattern": "\\.\\."
                }
              },
              "size_gb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "licence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "about": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              },
              "checked": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "min_ram_gb": {
                "type": "number",
                "minimum": 0
              },
              "ram_gb": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "brain_embed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "picked_from",
        "memory",
        "models"
      ],
      "properties": {
        "picked_from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "memory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "repo",
              "file",
              "size_gb",
              "licence",
              "about",
              "source",
              "checked",
              "dim",
              "pooling",
              "ctx",
              "languages"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
                "not": {
                  "pattern": "\\.\\."
                }
              },
              "file": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}\\.gguf$",
                "not": {
                  "pattern": "\\.\\."
                }
              },
              "size_gb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "licence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "about": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              },
              "checked": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "dim": {
                "type": "integer",
                "minimum": 1
              },
              "pooling": {
                "enum": [
                  "cls",
                  "mean",
                  "last",
                  "none",
                  "rank"
                ]
              },
              "ctx": {
                "type": "integer",
                "minimum": 1
              },
              "languages": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "about",
        "subscriptions",
        "pay_as_you_go"
      ],
      "properties": {
        "about": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "good_for",
              "plans",
              "free",
              "agents",
              "link",
              "source",
              "checked"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "good_for": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "plans": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "free": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "link": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              },
              "checked": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "maker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "pay_as_you_go": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "good_for",
              "plans",
              "free",
              "agents",
              "link",
              "source",
              "checked",
              "how"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "good_for": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "plans": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "free": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "link": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              },
              "checked": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "live": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "how": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "maker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "how_source": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "brain_server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "package",
        "version",
        "python",
        "licence",
        "source",
        "code",
        "checked",
        "download_mb",
        "disk_mb",
        "install_peak_mb",
        "ram_gb",
        "measured",
        "uv"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][0-9A-Za-z.+]{0,31}$"
        },
        "python": {
          "type": "string",
          "pattern": "^3\\.[0-9]{1,2}$"
        },
        "licence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source": {
          "type": "string",
          "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
          "maxLength": 500
        },
        "code": {
          "type": "string",
          "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
          "maxLength": 500
        },
        "checked": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "download_mb": {
          "type": "integer"
        },
        "disk_mb": {
          "type": "integer"
        },
        "install_peak_mb": {
          "type": "integer"
        },
        "ram_gb": {
          "type": "number"
        },
        "measured": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "uv": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "licence",
            "checked"
          ],
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
              "maxLength": 500
            },
            "licence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "checked": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      }
    },
    "agent_models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "about",
        "alias_source",
        "names_source",
        "models"
      ],
      "properties": {
        "about": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "alias_source": {
          "type": "string",
          "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
          "maxLength": 500
        },
        "names_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ids",
              "name",
              "maker",
              "good_for",
              "source",
              "checked"
            ],
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
                }
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "maker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "good_for": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^\\s'\"`$;|&<>\\\\]+$",
                "maxLength": 500
              },
              "checked": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        }
      }
    }
  }
}
